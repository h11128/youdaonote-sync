# Local overrides (optional). Copy to `.env` — gitignored.
# Runtime config SOT is NEVER the repo. See README "Single source of truth".
#
# Default SOT (no .env needed):
#   Windows: %APPDATA%\youdaonote-sync\
#   macOS/Linux: ~/.config/youdaonote-sync\
#
# Only set this to point at a different private directory:
# YOUDAONOTE_CONFIG_DIR=
# YOUDAONOTE_VERBOSE=0
