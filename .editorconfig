# Code Quality Standards — EditorConfig
# See: docs/code-quality-standards.md §11
#
# Copy to project root as `.editorconfig`

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,tsx,vue,json,yaml,yml,html,css,scss}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4

# Windows PowerShell 5.1 (powershell.exe) reads BOM-less .ps1 as the system ANSI
# codepage (GBK on zh-CN), which corrupts any non-ASCII char and breaks parsing.
# Keep .ps1 as UTF-8 with BOM so scheduled tasks parse correctly.
[*.ps1]
charset = utf-8-bom

[*.dart]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.gradle.kts]
indent_size = 4
