.env
.env.local
.env.*.local
*.pem
*.key

# Project config (user-specific runtime data — use platform SOT, not the repo)
config/
config.legacy-backup/
config.migrated-*/

captured_api_requests.json
logs/
backups/
*.backup.*
test-pull/

# Export directory (user-generated note files)
youdaonote-export/

# Local debug scripts
.local-scripts/

# Local-only notes (not product docs — keep on disk, never commit)
.local-docs/
.local-reports/

# Performance profiling
profiles/

# Python legacy
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

.cursor/

